+      platform_assert_status_ok(
+         platform_thread_create(&threads[i],
+                                FALSE,
+                                core_durable_barrier_insert_thread,
+                                &args[i],
+                                data->hid));
+      completed[i] = core_durable_barrier_test_wait(&args[i].done);
+      if (i == 0) {
+         blocked = core_durable_barrier_test_wait(
