+      uint64 child;
+      memcpy(&child,
+             page_handle_data(page) + (i % per_page) * sizeof(uint64),
+             sizeof(child));
+      uint64 count = MIN(data_extents, child_span);
+      rc           = blob_walk_extent(
+         cc, child, height - 1, child_span, count, disk_only, visit, arg);
+      if (!SUCCESS(rc)) {
