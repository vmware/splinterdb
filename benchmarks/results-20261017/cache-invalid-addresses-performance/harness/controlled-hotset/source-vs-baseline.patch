--- baseline/cache_api_probe.c
+++ cache_api_probe.c
@@ -4,12 +4,15 @@
 /* Real clockcache probe, shared unchanged with the baseline. All setup and
  * warmup are outside timing. Run only under the campaign benchmark lock on a
  * real disk. The file is opened O_DIRECT and contains the actual cached pages.
- * v3b: phase counters, deterministic worker registration, affinity and prewarm.
+ * Hotset variant of v3b: setup-only working-page override; timed code unchanged.
  * CACHE_PROBE_PERF=0 disables hardware counters with the same executable.
  * Usage: FILE CACHE_MIB THREADS[,THREADS...] SECONDS
  * [both|independent|dependent|churn|miss] [blocking|nonblocking|async].
  * CACHE_PROBE_DISK_RATIO defaults to 16. miss requires nonblocking and checks
  * valid allocated but uncached pages (STATUS_BUSY), without timed disk I/O.
+ * CACHE_PROBE_WORKING_PAGES optionally selects an exact resident/miss working
+ * set of >=32 pages, no larger than 75% of cache capacity. Unset preserves the
+ * original default size. It is incompatible with the churn mode.
  */
 #include <errno.h>
 #include <inttypes.h>
@@ -728,9 +731,25 @@
            worker_cpus_env, control_cpu, platform_get_tid(), ctx.warmup_seconds);
    ctx.pages =
       churn ? (uint64)cfg.page_capacity * 2 : (uint64)cfg.page_capacity * 3 / 4;
+   const char *working_pages_env = getenv("CACHE_PROBE_WORKING_PAGES");
+   if (working_pages_env != NULL) {
+      char *end = NULL;
+      errno = 0;
+      uint64 requested_pages = strtoull(working_pages_env, &end, 10);
+      platform_assert(!churn && *working_pages_env >= '0'
+                      && *working_pages_env <= '9' && *end == '\0'
+                      && errno != ERANGE && requested_pages >= 32
+                      && requested_pages <= (uint64)cfg.page_capacity * 3 / 4
+                      && requested_pages <= UINT32_MAX,
+                      "CACHE_PROBE_WORKING_PAGES must be >=32 and <=75%% "
+                      "of cache pages; it cannot be used with churn");
+      ctx.pages = requested_pages;
+   }
    uint64 extents =
       (ctx.pages + ctx.pages_per_extent - 1) / ctx.pages_per_extent;
-   ctx.pages     = extents * ctx.pages_per_extent;
+   if (working_pages_env == NULL) {
+      ctx.pages = extents * ctx.pages_per_extent;
+   }
    ctx.extents   = calloc(extents, sizeof(*ctx.extents));
    uint32 *order = malloc(ctx.pages * sizeof(*order));
    uint32 *next  = malloc(ctx.pages * sizeof(*next));
