+   if (UNLIKELY(*lookup_no >= lookup_capacity)) {
+      clockcache_report_invalid_address(cc, addr);
       return FALSE;
    }
    return TRUE;
 }
 
+/* Allocation membership is checked only for misses. Keep its callbacks and
