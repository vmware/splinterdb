-      return clockcache_get_from_disk(cc, addr, type, page, rc);
-   } else {
-      *rc = STATUS_BUSY;
-      return FALSE;
-   }
+   return clockcache_get_uncached(cc, addr, blocking, type, page, rc);
 }
 
