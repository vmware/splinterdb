diff --git a/src/clockcache.c b/src/clockcache.c
index e97f385f..4ab1fbc8 100644
--- a/src/clockcache.c
+++ b/src/clockcache.c
@@ -2402,6 +2402,32 @@ clockcache_get_from_disk(clockcache      *cc,   // IN
    return FALSE;
 }
 
+/* Keep allocation validation and disk admission out of the resident hit path.
+ * Nonblocking misses must still distinguish invalid addresses from busy pages.
+ */
+static __attribute__((noinline)) bool32
+clockcache_get_uncached(clockcache      *cc,
+                        uint64           addr,
+                        bool32           blocking,
+                        page_type        type,
+                        cache_page     **page,
+                        platform_status *rc)
+{
+   /* A hit inherits allocation validity from its mapping, which is removed by
+    * cache_extent_discard() before the allocator can free the extent. Check
+    * misses even for a nonblocking get, before returning STATUS_BUSY. */
+   if (!allocator_page_valid(cc->al, addr)) {
+      *rc = STATUS_BAD_PARAM;
+      return FALSE;
+   }
+   if (blocking) {
+      return clockcache_get_from_disk(cc, addr, type, page, rc);
+   } else {
+      *rc = STATUS_BUSY;
+      return FALSE;
+   }
+}
+
 /*
  *----------------------------------------------------------------------
  * clockcache_get_internal --
@@ -2443,19 +2469,7 @@ clockcache_get_internal(clockcache      *cc,       // IN
          cc, addr, blocking, type, entry_number, page, rc);
    }
 
-   /* A hit inherits allocation validity from its mapping, which is removed by
-    * cache_extent_discard() before the allocator can free the extent. Check
-    * misses even for a nonblocking get, before returning STATUS_BUSY. */
-   if (!allocator_page_valid(cc->al, addr)) {
-      *rc = STATUS_BAD_PARAM;
-      return FALSE;
-   }
