@@ -2631,6 +2645,15 @@ clockcache_get_from_disk_async(clockcache_get_async_state *state, uint64 depth)
 {
    async_begin(state, depth);
 
+   /* A miss must be allocated before it can reserve a cache entry or issue I/O.
